{
  "name": "mediakit",
  "version": "0.2.0",
  "description": "Real app screenshots and carousels from explicit design tokens and typed campaigns.",
  "keywords": [
    "mediakit",
    "screenshots",
    "carousel",
    "expo",
    "design-tokens"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ado11231/mediakit#readme",
  "bugs": {
    "url": "https://github.com/ado11231/mediakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ado11231/mediakit.git",
    "directory": "packages/mediakit"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./fixtures": {
      "types": "./dist/fixtures.d.ts",
      "import": "./dist/fixtures.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mediakit": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "fontkit": "^2.0.4",
    "jiti": "^2.7.0",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
