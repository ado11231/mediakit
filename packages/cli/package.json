{
  "name": "@mediakit/cli",
  "version": "0.0.0",
  "description": "The mediakit command line: init, preview, render, check.",
  "keywords": [
    "mediakit",
    "cli",
    "app-store",
    "screenshots",
    "marketing",
    "design-tokens",
    "play-store",
    "deterministic"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ado11231/mediakit#readme",
  "bugs": {
    "url": "https://github.com/ado11231/mediakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ado11231/mediakit.git",
    "directory": "packages/cli"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "mediakit": "./dist/bin.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ./scripts/shebang.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediakit/blocks": "workspace:*",
    "@mediakit/core": "workspace:*",
    "@mediakit/render-still": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
