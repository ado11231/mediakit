{
  "name": "@mediakit/render-still",
  "version": "0.0.0",
  "description": "Renders a mediakit spec to PNG with satori and resvg. No browser.",
  "keywords": [
    "mediakit",
    "satori",
    "resvg",
    "png",
    "screenshots",
    "render"
  ],
  "license": "MIT",
  "homepage": "https://github.com/ado11231/mediakit#readme",
  "bugs": {
    "url": "https://github.com/ado11231/mediakit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ado11231/mediakit.git",
    "directory": "packages/render-still"
  },
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@mediakit/core": "workspace:*",
    "@resvg/resvg-js": "^2.6.2",
    "satori": "^0.29.0"
  },
  "devDependencies": {
    "@mediakit/blocks": "workspace:*",
    "@types/node": "^22.20.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
