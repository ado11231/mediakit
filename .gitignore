# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
*.tsbuildinfo

# Turbo
.turbo/

# Test output
coverage/

# Rendered assets are committed on purpose: byte-identical PNGs across runs are
# what makes an approved screenshot diffable and reviewable (CLAUDE.md invariant 7).
# Golden files under packages/*/test are the determinism guarantee itself.
# Neither may be added here.

# Local design reference, deliberately never pushed. See reference/hvac-lead-loss/README.md.
# Read roadmap.md:119 before trusting it: the spacing in these renders is known wrong.
/reference/

# Spike render output. The M0 gate is the hash printed by the run, not a file in git.
/spike/out/

# Geist is SIL OFL and redistributable, but which font ships by default is an M1
# decision (design.md:239). No font binaries in a public repo before that is settled.
/spike/fonts/

# Local overrides
.env
.env.*
!.env.example

# Editor and OS
.DS_Store
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
