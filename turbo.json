{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      // Own build included, not just dependencies': the determinism test spawns a second
      // process against dist, which is the only way to prove a render is reproducible
      // rather than merely cached within one process.
      "dependsOn": ["^build", "build"]
    }
  }
}
